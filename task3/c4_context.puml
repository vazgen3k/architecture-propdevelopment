@startuml
!includeurl https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

title PropDevelopment — Диаграмма контекста C4
title Новые функции: интеллектуальный домофон и интеллектуальный шлагбаум

Person(owner, "Собственник", "Использует мобильное приложение для управления сервисами жилого комплекса")

System(app, "Витрина сервисов для собственников", "Позволяет собственнику управлять сервисами ЖК, включая доступ через домофон и шлагбаум", Mobile app(iOS, Android))

System_Ext(intercom, "Домофон", "Обеспечивает контроль доступа в подъезд и открытие двери")
System_Ext(barrier, "Шлагбаум", "Обеспечивает контроль въезда автомобиля на территорию")

Rel(owner, app, "Отправляет запросы на управление доступом, получает статусы и уведомления")
Rel(app, intercom, "Передаёт команды на открытие двери, получает события и статусы")
Rel(app, barrier, "Передаёт команды на открытие шлагбаума, получает события и статусы")

@enduml